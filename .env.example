# Postgres. Local: docker run -d --name zamu-pg -e POSTGRES_PASSWORD=zamu -e POSTGRES_USER=zamu -e POSTGRES_DB=zamu -p 5443:5432 postgres:17-alpine
DATABASE_URL="postgres://zamu:zamu@localhost:5443/zamu"

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Protects POST /api/cron/tick (header x-cron-secret). Generate with: openssl rand -hex 24
CRON_SECRET=""

# Public URL of the deployed site, for Open Graph links.
NEXT_PUBLIC_SITE_URL=""

# Optional: Nimiq RPC for NIM payout verification and staking reads.
NIMIQ_RPC_URL=""

# Local development only. Never set these in production.
# MOCK_PAYOUTS=1 answers Tando and Lightning-address calls with a fake partner.
# NEXT_PUBLIC_MOCK_NIMIQ=1 replaces Nimiq Pay with a mock wallet that signs for real.
MOCK_PAYOUTS=""
NEXT_PUBLIC_MOCK_NIMIQ=""
